{
  "name": "viewtower",
  "version": "1.1.0",
  "description": "viewtower.ai: The all-in-one AI-Coding Governance Platform",
  "keywords": [
    "viewtower",
    "claude",
    "claude-code",
    "hooks",
    "guardrails",
    "permissions",
    "ai-agents",
    "dashboard",
    "ai-coding governance",
    "governance"
  ],
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/viewtower/viewtower-client.git"
  },
  "homepage": "https://github.com/viewtower/viewtower-client#readme",
  "bugs": {
    "url": "https://github.com/viewtower/viewtower-client/issues"
  },
  "author": "",
  "main": "dist/main.js",
  "bin": {
    "viewtower": "dist/main.js"
  },
  "files": [
    "dist",
    "rules",
    "pipeline",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json && node -e \"require('fs').cpSync('src/dashboard/public','dist/dashboard/public',{recursive:true})\"",
    "prepublishOnly": "npm run build && npm test",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.test.json && tsc -p tsconfig.dashboard.json",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "type": "commonjs",
  "devDependencies": {
    "@types/node": "^26.6.3",
    "prettier": "3.10.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
