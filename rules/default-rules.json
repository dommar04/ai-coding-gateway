{
  "$schema": "./rule-file.schema.json",
  "name": "apichap AI Coding Gateway default rules",
  "version": 11,
  "description": "Starter rules, one group per policy. Allow everyday coding work, block destructive or risky actions. Anything no rule allows is denied. A matching deny rule always wins.",
  "groups": [
    {
      "id": "no-deleting-files",
      "title": "The agent is not allowed to delete files",
      "description": "Deleting files and folders is not allowed. Deleting through git is covered by the git group below.",
      "deny": [
        { "rule": "Shell(rm *)" },
        { "rule": "Shell(*/rm *)", "note": "rm called by its full path" },
        { "rule": "Shell(rmdir *)" },
        { "rule": "Shell(rd *)" },
        { "rule": "Shell(del *)" },
        { "rule": "Shell(erase *)" },
        { "rule": "Shell(Remove-Item *)" },
        { "rule": "Shell(find * -delete*)", "note": "find -delete removes files" }
      ]
    },
    {
      "id": "no-secrets",
      "title": "The agent is not allowed to read or change secret files",
      "description": ".env files, SSH keys, cloud credentials and certificates contain secrets. This applies to the file tools and to shell commands.",
      "deny": [
        { "rule": "File(**/.env*)", "note": ".env files contain secrets" },
        { "rule": "File(**/.ssh/**)", "note": "SSH keys" },
        { "rule": "File(**/.aws/**)", "note": "AWS credentials" },
        { "rule": "File(**/.netrc)", "note": "stored passwords" },
        { "rule": "File(**/*.pem)", "note": "private keys and certificates" },
        { "rule": "File({home}/.claude/.credentials.json)", "note": "Claude Code login" },
        { "rule": "Shell(* .env*)", "note": ".env files contain secrets" },
        { "rule": "Shell(*/.env*)", "note": ".env files contain secrets" },
        { "rule": "Shell(*\\.env*)", "note": ".env files contain secrets" },
        { "rule": "Shell(*/.ssh/*)", "note": "SSH keys" },
        { "rule": "Shell(*\\.ssh\\*)", "note": "SSH keys" },
        { "rule": "Shell(*~/.ssh*)", "note": "SSH keys" },
        { "rule": "Shell(*/.aws/*)", "note": "AWS credentials" },
        { "rule": "Shell(*\\.aws\\*)", "note": "AWS credentials" },
        { "rule": "Shell(*~/.aws*)", "note": "AWS credentials" }
      ]
    },
    {
      "id": "no-losing-git-work",
      "title": "The agent is not allowed to throw away work in git",
      "description": "Commands that discard uncommitted changes, delete branches or stashes, or rewrite history cannot be undone.",
      "deny": [
        { "rule": "Shell(git reset --hard*)", "note": "discards uncommitted work" },
        { "rule": "Shell(git clean *)", "note": "deletes untracked files" },
        { "rule": "Shell(git checkout -- *)", "note": "discards uncommitted changes" },
        { "rule": "Shell(git checkout .)", "note": "discards uncommitted changes" },
        { "rule": "Shell(git branch -D *)", "note": "force-deletes a branch without merge check" },
        { "rule": "Shell(git stash drop*)", "note": "drops stashed work" },
        { "rule": "Shell(git stash clear*)", "note": "drops all stashed work" },
        { "rule": "Shell(git reflog expire*)", "note": "destroys the history needed to recover work" },
        { "rule": "Shell(git gc --prune*)", "note": "destroys the history needed to recover work" },
        { "rule": "Shell(git filter-branch*)", "note": "rewrites repository history" },
        { "rule": "Shell(git filter-repo*)", "note": "rewrites repository history" },
        { "rule": "Shell(git update-ref -d*)", "note": "deletes refs directly" }
      ]
    },
    {
      "id": "no-overwriting-remote",
      "title": "The agent is not allowed to force-push or delete remote branches",
      "description": "Normal pushes are fine. Overwriting or deleting what is on the remote is not allowed.",
      "deny": [
        { "rule": "Shell(git push *--force*)", "note": "force-push rewrites shared history" },
        { "rule": "Shell(git push * -f*)", "note": "force-push rewrites shared history" },
        { "rule": "Shell(git push -f*)", "note": "force-push rewrites shared history" },
        { "rule": "Shell(git push *--mirror*)", "note": "a mirror push overwrites the remote" },
        { "rule": "Shell(git push *--delete*)", "note": "deletes remote branches" },
        { "rule": "Shell(git push * :*)", "note": "deletes remote branches" }
      ]
    },
    {
      "id": "no-git-tricks",
      "title": "The agent is not allowed to change git settings or skip git hooks",
      "description": "Git settings and aliases can make git run any program, and --no-verify skips the checks your hooks run.",
      "deny": [
        { "rule": "Shell(* --no-verify*)", "note": "skips git hooks" },
        { "rule": "Shell(git -c *)", "note": "per-command git config can run arbitrary programs" },
        { "rule": "Shell(git config *alias.*)", "note": "git aliases can run arbitrary commands" },
        { "rule": "Shell(git config *core.hooksPath*)", "note": "changes which hooks git runs" },
        { "rule": "Shell(git config *core.sshCommand*)", "note": "can make git run arbitrary programs" },
        { "rule": "Shell(git config --global *)", "note": "changes global git settings" },
        { "rule": "Shell(git config --system *)", "note": "changes system-wide git settings" },
        { "rule": "Shell(git submodule foreach*)", "note": "runs arbitrary commands in every submodule" },
        { "rule": "Shell(git bisect run*)", "note": "runs arbitrary commands" }
      ]
    },
    {
      "id": "no-unreviewed-code",
      "title": "The agent is not allowed to run inline or downloaded code",
      "description": "Code passed on the command line or piped into a shell runs without anyone seeing it. Put it in a script file in the project instead.",
      "deny": [
        { "rule": "Shell(*| sh *)", "note": "piping into a shell" },
        { "rule": "Shell(*|sh *)", "note": "piping into a shell" },
        { "rule": "Shell(*| bash *)", "note": "piping into a shell" },
        { "rule": "Shell(*|bash *)", "note": "piping into a shell" },
        { "rule": "Shell(*| iex*)", "note": "piping into Invoke-Expression" },
        { "rule": "Shell(*Invoke-Expression*)", "note": "Invoke-Expression runs a string as code" },
        { "rule": "Shell(iex *)", "note": "Invoke-Expression runs a string as code" },
        { "rule": "Shell(node -e *)", "note": "inline code" },
        { "rule": "Shell(node --eval *)", "note": "inline code" },
        { "rule": "Shell(node -p *)", "note": "inline code" },
        { "rule": "Shell(node --print *)", "note": "inline code" },
        { "rule": "Shell(npx tsx -e *)", "note": "inline code" },
        { "rule": "Shell(npx tsx --eval *)", "note": "inline code" },
        { "rule": "Shell(python -c *)", "note": "inline code" },
        { "rule": "Shell(python3 -c *)", "note": "inline code" },
        { "rule": "Shell(find * -exec*)", "note": "find -exec runs arbitrary commands" },
        { "rule": "Shell(*LD_PRELOAD=*)", "note": "injects code into other programs" },
        { "rule": "Shell(*DYLD_INSERT_LIBRARIES=*)", "note": "injects code into other programs" },
        { "rule": "Shell(*NODE_OPTIONS=*)", "note": "can make every node process load extra code" }
      ]
    },
    {
      "id": "no-system-changes",
      "title": "The agent is not allowed to use admin rights or change the machine",
      "description": "No sudo, no disk formatting, no shutdown or reboot, no world-writable permissions.",
      "deny": [
        { "rule": "Shell(sudo *)", "note": "no elevated privileges" },
        { "rule": "Shell(chmod 777*)", "note": "world-writable permissions" },
        { "rule": "Shell(dd *)", "note": "raw disk writes" },
        { "rule": "Shell(mkfs*)", "note": "formatting disks" },
        { "rule": "Shell(format *)", "note": "formatting disks" },
        { "rule": "Shell(Format-Volume*)", "note": "formatting disks" },
        { "rule": "Shell(shutdown*)", "note": "shutting down the machine" },
        { "rule": "Shell(reboot*)", "note": "rebooting the machine" },
        { "rule": "Shell(Stop-Computer*)", "note": "shutting down the machine" },
        { "rule": "Shell(Restart-Computer*)", "note": "rebooting the machine" }
      ]
    },
    {
      "id": "no-publishing",
      "title": "The agent is not allowed to publish packages",
      "description": "Publishing a package makes it public and usually cannot be undone.",
      "deny": [{ "rule": "Shell(npm publish*)" }]
    },
    {
      "id": "protect-gateway",
      "title": "The agent is not allowed to change the gateway or Claude Code's settings",
      "description": "Otherwise the agent could switch the gateway off, allow its own calls or remove the hooks. Managing the gateway is for you, not the agent.",
      "deny": [
        { "rule": "Shell(apichap-gateway *)", "note": "the gateway's CLI" },
        { "rule": "Shell(npx *apichap-ai-coding-gateway*)", "note": "the gateway's CLI" },
        { "rule": "Shell(pnpm dlx *apichap-ai-coding-gateway*)", "note": "the gateway's CLI" },
        { "rule": "Shell(yarn dlx *apichap-ai-coding-gateway*)", "note": "the gateway's CLI" },
        { "rule": "Shell(bunx *apichap-ai-coding-gateway*)", "note": "the gateway's CLI" },
        { "rule": "Shell(node *apichap-ai-coding-gateway*)", "note": "the gateway's CLI" },
        { "rule": "Shell(*/.ai-coding-gateway*)", "note": "the gateway's data" },
        { "rule": "Shell(*\\.ai-coding-gateway*)", "note": "the gateway's data" },
        { "rule": "Shell(*~/.ai-coding-gateway*)", "note": "the gateway's data" },
        { "rule": "FileEdit({home}/.ai-coding-gateway/**)", "note": "the gateway's data" },
        { "rule": "FileEdit(**/.claude/settings*.json)", "note": "Claude Code settings (hooks)" },
        { "rule": "Shell(*.claude/settings*)", "note": "Claude Code settings (hooks)" },
        { "rule": "Shell(*.claude\\settings*)", "note": "Claude Code settings (hooks)" }
      ]
    },
    {
      "id": "read-inside-project",
      "title": "The agent is allowed to read and search files only inside the current project and Claude´s home holder",
      "description": "Reading other projects, the home folder or system files is denied until you allow it. Shell commands like cat are not path-checked.",
      "allow": [
        { "rule": "FileRead({cwd}/**)", "note": "the current project" },
        { "rule": "FileRead({tmp}/claude/**)", "note": "Claude Code's scratchpad folder" },
        { "rule": "FileRead({home}/.claude/**)", "note": "Claude Code's home folder" },
        { "rule": "FileRead({home}/.ai-coding-gateway/spill/**)", "note": "full output of calls the gateway shortened" }
      ]
    },
    {
      "id": "edit-inside-project",
      "title": "The agent is allowed to change files only inside the current project",
      "description": "Creating and editing files elsewhere is denied until you allow it. Claude Code's scratchpad, plan and memory files are included.",
      "allow": [
        { "rule": "FileEdit({cwd}/**)", "note": "the current project" },
        { "rule": "FileEdit({tmp}/claude/**)", "note": "Claude Code's scratchpad folder" },
        { "rule": "FileEdit({home}/.claude/plans/**)", "note": "Claude Code's plan files" },
        { "rule": "FileEdit({home}/.claude/projects/*/memory/**)", "note": "Claude Code's memory files" }
      ]
    },
    {
      "id": "claude-code-tools",
      "title": "The agent is allowed to plan, ask, search the web and use sub-agents",
      "description": "Claude Code's built-in helper tools. None of them change files or run commands on their own.",
      "allow": [
        { "rule": "TodoWrite" },
        { "rule": "Task" },
        { "rule": "Agent" },
        { "rule": "ToolSearch" },
        { "rule": "Skill" },
        { "rule": "AskUserQuestion" },
        { "rule": "EnterPlanMode" },
        { "rule": "ExitPlanMode" },
        { "rule": "WebSearch" },
        { "rule": "ListAgents" },
        { "rule": "TaskStop", "note": "stop a background task" },
        { "rule": "TaskOutput", "note": "read a background task's output" },
        { "rule": "BashOutput", "note": "read a background shell's output" },
        { "rule": "KillShell", "note": "stop a background shell" }
      ]
    },
    {
      "id": "git",
      "title": "The agent is allowed to use git",
      "description": "Commit, branch, diff, pull and push. The risky parts are denied by the git groups above.",
      "allow": [{ "rule": "Shell(git *)" }]
    },
    {
      "id": "node-tooling",
      "title": "The agent is allowed to install dependencies, build, test and format",
      "description": "npm and the usual npx tools for tests, linting, formatting and type checks.",
      "allow": [
        { "rule": "Shell(npm install *)" },
        { "rule": "Shell(npm ci *)" },
        { "rule": "Shell(npm test *)" },
        { "rule": "Shell(npm run *)", "note": "package scripts" },
        { "rule": "Shell(npm ls *)" },
        { "rule": "Shell(npm pack *)", "note": "build a local package tarball" },
        { "rule": "Shell(npm view *)", "note": "read package info from the registry" },
        { "rule": "Shell(npm outdated *)" },
        { "rule": "Shell(npm --version)" },
        { "rule": "Shell(node --version)" },
        { "rule": "Shell(npx prettier *)" },
        { "rule": "Shell(npx eslint *)" },
        { "rule": "Shell(npx vitest *)" },
        { "rule": "Shell(npx jest *)" },
        { "rule": "Shell(npx tsc *)" }
      ]
    },
    {
      "id": "run-scripts",
      "title": "The agent is allowed to run script files with node and python",
      "description": "Script files can be reviewed in the project. Inline code (node -e, python -c) is denied above.",
      "allow": [
        { "rule": "Shell(node *)" },
        { "rule": "Shell(npx tsx *)" },
        { "rule": "Shell(python *)" },
        { "rule": "Shell(python3 *)" }
      ]
    },
    {
      "id": "shell-basics",
      "title": "The agent is allowed to use basic shell commands",
      "description": "Look around, read, search and process text, create folders and empty files.",
      "allow": [
        { "rule": "Shell(cd *)" },
        { "rule": "Shell(ls *)" },
        { "rule": "Shell(pwd)" },
        { "rule": "Shell(cat *)" },
        { "rule": "Shell(head *)" },
        { "rule": "Shell(tail *)" },
        { "rule": "Shell(wc *)" },
        { "rule": "Shell(echo *)" },
        { "rule": "Shell(printf *)" },
        { "rule": "Shell(which *)" },
        { "rule": "Shell(grep *)" },
        { "rule": "Shell(rg *)" },
        { "rule": "Shell(find *)" },
        { "rule": "Shell(sort *)" },
        { "rule": "Shell(uniq *)" },
        { "rule": "Shell(diff *)" },
        { "rule": "Shell(mkdir *)" },
        { "rule": "Shell(touch *)" },
        { "rule": "Shell(sed *)", "note": "can also edit files in place, like the Edit tool" },
        { "rule": "Shell(awk *)" },
        { "rule": "Shell(mktemp *)" },
        { "rule": "Shell(test *)" },
        { "rule": "Shell([ *)" },
        { "rule": "Shell(date *)" },
        { "rule": "PowerShell(Get-ChildItem *)" },
        { "rule": "PowerShell(Get-Content *)" },
        { "rule": "PowerShell(Get-Location *)" },
        { "rule": "PowerShell(Set-Location *)" },
        { "rule": "PowerShell(Select-String *)" },
        { "rule": "PowerShell(Test-Path *)" },
        { "rule": "PowerShell(Get-Command *)" },
        { "rule": "PowerShell(Write-Output *)" },
        { "rule": "PowerShell(New-Item -ItemType Directory *)" }
      ]
    }
  ]
}
