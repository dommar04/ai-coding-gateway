{
  "$schema": "./rule-file.schema.json",
  "name": "apichap AI Coding Gateway default rules",
  "version": 8,
  "description": "Starter rules. Allow everyday coding work, deny destructive or risky actions. Anything not allowed becomes an approval request. A matching deny rule always wins.",
  "allow": [
    { "rule": "Read", "note": "read-only / planning tool" },
    { "rule": "Glob", "note": "read-only / planning tool" },
    { "rule": "Grep", "note": "read-only / planning tool" },
    { "rule": "TodoWrite", "note": "read-only / planning tool" },
    { "rule": "Task", "note": "read-only / planning tool" },
    { "rule": "Agent", "note": "read-only / planning tool" },
    { "rule": "ToolSearch", "note": "read-only / planning tool" },
    { "rule": "Skill", "note": "read-only / planning tool" },
    { "rule": "AskUserQuestion", "note": "read-only / planning tool" },
    { "rule": "EnterPlanMode", "note": "read-only / planning tool" },
    { "rule": "ExitPlanMode", "note": "read-only / planning tool" },
    { "rule": "WebSearch", "note": "read-only / planning tool" },
    { "rule": "ListAgents", "note": "read-only / planning tool" },
    { "rule": "TaskStop", "note": "Claude Code: stop a background task" },
    { "rule": "TaskOutput", "note": "Claude Code: read a background task's output" },
    { "rule": "BashOutput", "note": "Claude Code: read a background shell's output" },
    { "rule": "KillShell", "note": "Claude Code: stop a background shell" },
    { "rule": "FileEdit({cwd}/**)", "note": "edit files inside the current project" },
    { "rule": "FileEdit({tmp}/claude/**)", "note": "Claude Code's scratchpad folder" },
    { "rule": "FileEdit({home}/.claude/plans/**)", "note": "Claude Code's plan files" },
    { "rule": "FileEdit({home}/.claude/projects/*/memory/**)", "note": "Claude Code's memory files" },
    { "rule": "Shell(git *)", "note": "git (risky subcommands are denied separately)" },
    { "rule": "Shell(npm install *)", "note": "install dependencies" },
    { "rule": "Shell(npm ci *)", "note": "install dependencies" },
    { "rule": "Shell(npm test *)", "note": "run tests" },
    { "rule": "Shell(npm run *)", "note": "run package scripts" },
    { "rule": "Shell(npm ls *)", "note": "list dependencies" },
    { "rule": "Shell(npm pack *)", "note": "build a local package tarball" },
    { "rule": "Shell(npm view *)", "note": "read package info from the registry" },
    { "rule": "Shell(npm outdated *)", "note": "list outdated dependencies" },
    { "rule": "Shell(npx prettier *)", "note": "format code" },
    { "rule": "Shell(npx eslint *)", "note": "lint code" },
    { "rule": "Shell(npx vitest *)", "note": "run tests" },
    { "rule": "Shell(npx jest *)", "note": "run tests" },
    { "rule": "Shell(node *)", "note": "run project scripts (inline code with -e/-p is denied separately)" },
    { "rule": "Shell(npx tsx *)", "note": "run project scripts (inline code with -e is denied separately)" },
    { "rule": "Shell(python *)", "note": "run project scripts (inline code with -c is denied separately)" },
    { "rule": "Shell(python3 *)", "note": "run project scripts (inline code with -c is denied separately)" },
    { "rule": "Shell(npx tsc *)", "note": "type-check" },
    { "rule": "Shell(node --version)", "note": "version check" },
    { "rule": "Shell(npm --version)", "note": "version check" },
    { "rule": "Shell(cd *)", "note": "change directory" },
    { "rule": "Shell(ls *)", "note": "list files" },
    { "rule": "Shell(pwd)", "note": "print directory" },
    { "rule": "Shell(cat *)", "note": "read files" },
    { "rule": "Shell(head *)", "note": "read files" },
    { "rule": "Shell(tail *)", "note": "read files" },
    { "rule": "Shell(wc *)", "note": "count lines" },
    { "rule": "Shell(echo *)", "note": "print text" },
    { "rule": "Shell(printf *)", "note": "print text" },
    { "rule": "Shell(which *)", "note": "locate programs" },
    { "rule": "Shell(grep *)", "note": "search" },
    { "rule": "Shell(rg *)", "note": "search" },
    { "rule": "Shell(find *)", "note": "find files" },
    { "rule": "Shell(sort *)", "note": "text processing" },
    { "rule": "Shell(uniq *)", "note": "text processing" },
    { "rule": "Shell(diff *)", "note": "compare files" },
    { "rule": "Shell(mkdir *)", "note": "create folders" },
    { "rule": "Shell(touch *)", "note": "create empty files" },
    { "rule": "Shell(sed *)", "note": "text processing (can also edit files in place, like the Edit tool)" },
    { "rule": "Shell(awk *)", "note": "text processing" },
    { "rule": "Shell(mktemp *)", "note": "create an empty temp file or folder" },
    { "rule": "Shell(test *)", "note": "check files and values" },
    { "rule": "Shell([ *)", "note": "check files and values" },
    { "rule": "Shell(date *)", "note": "print date" },
    { "rule": "PowerShell(Get-ChildItem *)", "note": "list files" },
    { "rule": "PowerShell(Get-Content *)", "note": "read files" },
    { "rule": "PowerShell(Get-Location *)", "note": "print directory" },
    { "rule": "PowerShell(Set-Location *)", "note": "change directory" },
    { "rule": "PowerShell(Select-String *)", "note": "search" },
    { "rule": "PowerShell(Test-Path *)", "note": "check path exists" },
    { "rule": "PowerShell(Get-Command *)", "note": "locate programs" },
    { "rule": "PowerShell(Write-Output *)", "note": "print text" },
    { "rule": "PowerShell(New-Item -ItemType Directory *)", "note": "create folders" }
  ],
  "deny": [
    { "rule": "Shell(rm *)", "note": "deleting files needs admin approval" },
    { "rule": "Shell(*/rm *)", "note": "deleting files needs admin approval" },
    { "rule": "Shell(rmdir *)", "note": "deleting folders needs admin approval" },
    { "rule": "Shell(rd *)", "note": "deleting folders needs admin approval" },
    { "rule": "Shell(del *)", "note": "deleting files needs admin approval" },
    { "rule": "Shell(erase *)", "note": "deleting files needs admin approval" },
    { "rule": "Shell(Remove-Item *)", "note": "deleting files needs admin approval" },
    { "rule": "Shell(find * -delete*)", "note": "find -delete removes files" },
    { "rule": "Shell(find * -exec*)", "note": "find -exec runs arbitrary commands" },
    { "rule": "Shell(sudo *)", "note": "no elevated privileges" },
    { "rule": "Shell(git push *--force*)", "note": "force-push rewrites shared history" },
    { "rule": "Shell(git push * -f*)", "note": "force-push rewrites shared history" },
    { "rule": "Shell(git push -f*)", "note": "force-push rewrites shared history" },
    { "rule": "Shell(git push *--mirror*)", "note": "a mirror push overwrites the remote" },
    { "rule": "Shell(git push *--delete*)", "note": "deleting remote branches needs admin approval" },
    { "rule": "Shell(git push * :*)", "note": "deleting remote branches needs admin approval" },
    { "rule": "Shell(git reset --hard*)", "note": "hard reset discards uncommitted work" },
    { "rule": "Shell(git clean *)", "note": "git clean deletes untracked files" },
    { "rule": "Shell(git checkout -- *)", "note": "discards uncommitted changes" },
    { "rule": "Shell(git checkout .)", "note": "discards uncommitted changes" },
    { "rule": "Shell(git branch -D *)", "note": "force-deletes a branch without merge check" },
    { "rule": "Shell(git stash drop*)", "note": "drops stashed work" },
    { "rule": "Shell(git stash clear*)", "note": "drops all stashed work" },
    { "rule": "Shell(git reflog expire*)", "note": "destroys the history needed to recover work" },
    { "rule": "Shell(git gc --prune*)", "note": "destroys the history needed to recover work" },
    { "rule": "Shell(git filter-branch*)", "note": "rewrites repository history" },
    { "rule": "Shell(git filter-repo*)", "note": "rewrites repository history" },
    { "rule": "Shell(git update-ref -d*)", "note": "deletes refs directly" },
    { "rule": "Shell(git -c *)", "note": "per-command git config can run arbitrary programs" },
    { "rule": "Shell(git config *alias.*)", "note": "git aliases can run arbitrary commands" },
    { "rule": "Shell(git config *core.hooksPath*)", "note": "changes which hooks git runs" },
    { "rule": "Shell(git config *core.sshCommand*)", "note": "can make git run arbitrary programs" },
    { "rule": "Shell(git config --global *)", "note": "changes global git settings" },
    { "rule": "Shell(git config --system *)", "note": "changes system-wide git settings" },
    { "rule": "Shell(git submodule foreach*)", "note": "runs arbitrary commands in every submodule" },
    { "rule": "Shell(git bisect run*)", "note": "runs arbitrary commands" },
    { "rule": "Shell(* --no-verify*)", "note": "skipping git hooks is not allowed" },
    { "rule": "Shell(chmod 777*)", "note": "world-writable permissions" },
    { "rule": "Shell(dd *)", "note": "raw disk writes" },
    { "rule": "Shell(mkfs*)", "note": "formatting disks" },
    { "rule": "Shell(format *)", "note": "formatting disks" },
    { "rule": "Shell(Format-Volume*)", "note": "formatting disks" },
    { "rule": "Shell(shutdown*)", "note": "shutting down the machine" },
    { "rule": "Shell(reboot*)", "note": "rebooting the machine" },
    { "rule": "Shell(Stop-Computer*)", "note": "shutting down the machine" },
    { "rule": "Shell(Restart-Computer*)", "note": "rebooting the machine" },
    { "rule": "Shell(*| sh *)", "note": "piping into a shell runs unreviewed code" },
    { "rule": "Shell(*|sh *)", "note": "piping into a shell runs unreviewed code" },
    { "rule": "Shell(*| bash *)", "note": "piping into a shell runs unreviewed code" },
    { "rule": "Shell(*|bash *)", "note": "piping into a shell runs unreviewed code" },
    { "rule": "Shell(*| iex*)", "note": "piping into Invoke-Expression runs unreviewed code" },
    { "rule": "Shell(*Invoke-Expression*)", "note": "Invoke-Expression runs unreviewed code" },
    { "rule": "Shell(iex *)", "note": "Invoke-Expression runs unreviewed code" },
    { "rule": "Shell(npm publish*)", "note": "publishing packages needs admin approval" },
    { "rule": "Shell(node -e *)", "note": "inline code can do anything unreviewed; put it in a script file in the project" },
    { "rule": "Shell(node --eval *)", "note": "inline code can do anything unreviewed; put it in a script file in the project" },
    { "rule": "Shell(node -p *)", "note": "inline code can do anything unreviewed; put it in a script file in the project" },
    { "rule": "Shell(node --print *)", "note": "inline code can do anything unreviewed; put it in a script file in the project" },
    { "rule": "Shell(npx tsx -e *)", "note": "inline code can do anything unreviewed; put it in a script file in the project" },
    { "rule": "Shell(npx tsx --eval *)", "note": "inline code can do anything unreviewed; put it in a script file in the project" },
    { "rule": "Shell(python -c *)", "note": "inline code can do anything unreviewed; put it in a script file in the project" },
    { "rule": "Shell(python3 -c *)", "note": "inline code can do anything unreviewed; put it in a script file in the project" },
    { "rule": "Shell(*LD_PRELOAD=*)", "note": "injects code into other programs" },
    { "rule": "Shell(*DYLD_INSERT_LIBRARIES=*)", "note": "injects code into other programs" },
    { "rule": "Shell(*NODE_OPTIONS=*)", "note": "can make every node process load extra code" },
    { "rule": "Shell(*/.ssh/*)", "note": "SSH keys are off-limits" },
    { "rule": "Shell(*\\.ssh\\*)", "note": "SSH keys are off-limits" },
    { "rule": "Shell(*~/.ssh*)", "note": "SSH keys are off-limits" },
    { "rule": "Shell(* .env*)", "note": ".env files contain secrets" },
    { "rule": "Shell(*/.env*)", "note": ".env files contain secrets" },
    { "rule": "Shell(*\\.env*)", "note": ".env files contain secrets" },
    { "rule": "Shell(*.claude/settings*)", "note": "Claude Code settings (hooks) are admin-only" },
    { "rule": "Shell(*.claude\\settings*)", "note": "Claude Code settings (hooks) are admin-only" },
    { "rule": "Shell(apichap-gateway *)", "note": "managing the apichap AI Coding Gateway is admin-only" },
    { "rule": "Shell(npx *apichap-ai-coding-gateway*)", "note": "managing the apichap AI Coding Gateway is admin-only" },
    { "rule": "Shell(pnpm dlx *apichap-ai-coding-gateway*)", "note": "managing the apichap AI Coding Gateway is admin-only" },
    { "rule": "Shell(yarn dlx *apichap-ai-coding-gateway*)", "note": "managing the apichap AI Coding Gateway is admin-only" },
    { "rule": "Shell(bunx *apichap-ai-coding-gateway*)", "note": "managing the apichap AI Coding Gateway is admin-only" },
    { "rule": "Shell(node *apichap-ai-coding-gateway*)", "note": "managing the apichap AI Coding Gateway is admin-only" },
    { "rule": "Shell(*/.apichap-gateway*)", "note": "the apichap AI Coding Gateway's data is admin-only" },
    { "rule": "Shell(*\\.apichap-gateway*)", "note": "the apichap AI Coding Gateway's data is admin-only" },
    { "rule": "Shell(*~/.apichap-gateway*)", "note": "the apichap AI Coding Gateway's data is admin-only" },
    { "rule": "File(**/.env*)", "note": ".env files contain secrets" },
    { "rule": "File(**/.ssh/**)", "note": "SSH keys are off-limits" },
    { "rule": "FileEdit(**/.claude/settings*.json)", "note": "Claude Code settings (hooks) are admin-only" },
    { "rule": "FileEdit({home}/.apichap-gateway/**)", "note": "the apichap AI Coding Gateway's data is admin-only" }
  ]
}
